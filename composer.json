{
    "name": "cyvax/privatebin_php",
    "type": "library",
    "description": "PHP client library for PrivateBin with client-side encryption and decryption support.",
    "keywords": [
        "privatebin",
        "paste",
        "encryption"
    ],
    "homepage": "https://github.com/cyvax/Privatebin_PHP",
    "license": "MIT",
    "authors": [
        {
            "name": "CyVaX",
            "email": "contact@cyvax.fr",
            "homepage": "https://cyvax.fr/",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/cyvax/Privatebin_PHP/issues",
        "wiki": "https://github.com/cyvax/Privatebin_PHP/wiki",
        "source": "https://github.com/cyvax/Privatebin_PHP"
    },
    "require": {
        "php": ">=7.1.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "suggest": {
        "ext-gmp": "Faster Base58 encoding and decoding.",
        "ext-fileinfo": "Accurate MIME type detection for attachments.",
        "ext-zlib": "Required for zlib compression."
    },
    "_comment": [
        "Development and test tooling require PHP 8.5+.",
        "The library runtime itself remains compatible with PHP 7.1+.",
        "Reason: the PrivatebinPHPPipe client is designed for the PHP 8.5 pipe operator and the test suite uses modern PHPUnit syntax."
    ],
    "require-dev": {
        "phpunit/phpunit": "^13.1"
    },
    "autoload": {
        "psr-4": {
            "Cyvax\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cyvax\\Tests\\": "tests/"
        }
    },
    "prefer-stable": true
}
